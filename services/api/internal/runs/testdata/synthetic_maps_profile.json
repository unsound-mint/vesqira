              "extver": 1
            },
            "centre": {
              "file": "synth_decomp_ext.fits",
              "hdu": "CENTRE"
            },
            "width": {
              "file": "synth_decomp_ext.fits",
              "hdu": "FWHM"
            }
          },
          "componentAxis": 3
        },
        "amplitude": {},
        "centre": {
          "frame": "LSRK"
        },
        "width": {
          "kind": "fwhm",
          "unit": "km/s"
        },
        "order": "slot index along the component axis, as the tool numbers them",
        "components": "config.n_components",
        "crop": "input.path"
      }
    }
  ]
