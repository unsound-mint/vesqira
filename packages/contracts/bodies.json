{
 "schemas": {
  "Error": {
   "type": "object",
   "required": [
    "error"
   ],
   "properties": {
    "error": {
     "type": "string"
    },
    "reasons": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "Axis": {
   "type": "object",
   "required": [
    "axis",
    "length",
    "ctype",
    "ctype_status",
    "cunit",
    "cunit_status",
    "crval",
    "crval_status",
    "crpix",
    "crpix_status",
    "cdelt",
    "cdelt_status"
   ],
   "description": "One FITS axis as the file declares it. A status of unresolved means the keyword is absent; the value is then null, never a default.",
   "properties": {
    "axis": {
     "type": "integer",
     "description": "1-based FITS axis number"
    },
    "length": {
     "type": "integer"
    },
    "ctype": {
     "type": "string",
     "nullable": true
    },
    "ctype_status": {
     "type": "string",
     "enum": [
      "declared",
      "unresolved"
     ]
    },
    "cunit": {
     "type": "string",
     "nullable": true
    },
    "cunit_status": {
     "type": "string",
     "enum": [
      "declared",
      "unresolved"
     ]
    },
    "crval": {
     "type": "number",
     "nullable": true
    },
    "crval_status": {
     "type": "string",
     "enum": [
      "declared",
      "unresolved"
     ]
    },
    "crpix": {
     "type": "number",
     "nullable": true
    },
    "crpix_status": {
     "type": "string",
     "enum": [
      "declared",
      "unresolved"
     ]
    },
    "cdelt": {
     "type": "number",
     "nullable": true
    },
    "cdelt_status": {
     "type": "string",
     "enum": [
      "declared",
      "unresolved"
     ]
    }
   }
  },
  "Beam": {
   "type": "object",
   "required": [
    "status"
   ],
   "properties": {
    "bmaj": {
     "type": "number"
    },
    "bmin": {
     "type": "number"
    },
    "bpa": {
     "type": "number"
    },
    "status": {
     "type": "string",
     "enum": [
      "declared",
      "unresolved"
     ]
    },
    "note": {
     "type": "string"
    }
   }
  },
  "FitsHeader": {
   "type": "object",
   "description": "Header facts the worker read from the file when it was registered. Extra keys may be present and are not part of the contract.",
   "required": [
    "naxis",
    "bitpix",
    "axes",
    "bunit",
    "bunit_status",
    "specsys",
    "radesys"
   ],
   "properties": {
    "naxis": {
     "type": "integer"
    },
    "bitpix": {
     "type": "integer",
     "nullable": true
    },
    "axes": {
     "type": "array",
     "items": {
      "$ref": "#/components/schemas/Axis"
     }
    },
    "bunit": {
     "type": "string",
     "nullable": true
    },
    "bunit_status": {
     "type": "string",
     "enum": [
      "declared",
      "unresolved"
     ]
    },
    "specsys": {
     "type": "string",
     "nullable": true
    },
    "radesys": {
     "type": "string",
     "nullable": true
    },
    "beam": {
     "$ref": "#/components/schemas/Beam"
    }
   }
  },
  "Interpretation": {
   "type": "object",
   "description": "What the user declared about the data; the file itself declares none of it.",
   "required": [
    "kind",
    "unit",
    "reliabilityId",
    "declaredBy",
    "declaredAt",
    "stale"
   ],
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "axial_orientation"
     ]
    },
    "unit": {
     "type": "string",
     "enum": [
      "deg",
      "rad"
     ]
    },
    "reliabilityId": {
     "type": "integer",
     "nullable": true,
     "format": "int64"
    },
    "declaredBy": {
     "type": "string"
    },
    "declaredAt": {
     "type": "string",
     "format": "date-time"
    },
    "stale": {
     "type": "boolean"
    }
   }
  },
  "Dataset": {
   "type": "object",
   "description": "A registered dataset: a reference to the original file plus header facts. The file itself is never altered.",
   "required": [
    "id",
    "path",
    "name",
    "sizeBytes",
    "modifiedAt",
    "addedAt",
    "header",
    "hostId",
    "nature",
    "interpretation",
    "unitDeclaration"
   ],
   "properties": {
    "id": {
     "type": "integer",
     "format": "int64"
    },
    "path": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "sizeBytes": {
     "type": "integer",
     "format": "int64"
    },
    "modifiedAt": {
     "type": "string",
     "format": "date-time"
    },
    "addedAt": {
     "type": "string",
     "format": "date-time"
    },
    "header": {
     "$ref": "#/components/schemas/FitsHeader"
    },
    "hostId": {
     "type": "integer",
     "format": "int64",
     "description": "0 for a file on this computer, otherwise the remote host that holds it"
    },
    "nature": {
     "type": "string",
     "enum": [
      "",
      "observed",
      "simulated",
      "constructed_control"
     ],
     "description": "Empty means not declared"
    },
    "interpretation": {
     "allOf": [
      {
       "$ref": "#/components/schemas/Interpretation"
      }
     ],
     "nullable": true
    },
    "unitDeclaration": {
     "allOf": [
      {
       "$ref": "#/components/schemas/UnitDeclaration"
      }
     ],
     "nullable": true,
     "description": "Present when the person declared a unit for a file without BUNIT. The header's own bunit and bunit_status stay as the file gave them."
    }
   }
  },
  "DatasetList": {
   "type": "object",
   "required": [
    "datasets"
   ],
   "properties": {
    "datasets": {
     "type": "array",
     "items": {
      "$ref": "#/components/schemas/Dataset"
     }
    }
   }
  },
  "SkyPixel": {
   "type": "object",
   "required": [
    "kind",
    "note"
   ],
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "pixel"
     ]
    },
    "note": {
     "type": "string"
    }
   }
  },
  "SkyCelestial": {
   "type": "object",
   "required": [
    "kind",
    "lon_name",
    "lat_name",
    "projection",
    "frame",
    "frame_status",
    "unit"
   ],
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "celestial"
     ]
    },
    "lon_name": {
     "type": "string"
    },
    "lat_name": {
     "type": "string"
    },
    "projection": {
     "type": "string",
     "nullable": true
    },
    "frame": {
     "type": "string",
     "nullable": true
    },
    "frame_status": {
     "type": "string",
     "enum": [
      "declared",
      "inferred",
      "unresolved"
     ]
    },
    "unit": {
     "type": "string",
     "enum": [
      "deg"
     ]
    }
   }
  },
  "SpectralFacts": {
   "type": "object",
   "required": [
    "fits_axis",
    "ctype",
    "name",
    "is_spectral",
    "resolved",
    "unit",
    "unit_status",
    "velocity"
   ],
   "properties": {
    "fits_axis": {
     "type": "integer"
    },
    "ctype": {
     "type": "string",
     "nullable": true
    },
    "name": {
     "type": "string"
    },
    "is_spectral": {
     "type": "boolean"
    },
    "resolved": {
     "type": "boolean"
    },
    "unit": {
     "type": "string",
     "nullable": true
    },
    "unit_status": {
     "type": "string",
     "enum": [
      "declared",
      "inferred",
      "unresolved"
     ]
    },
    "velocity": {
     "type": "string",
     "enum": [
      "declared",
      "unresolved"
     ]
    },
    "note": {
     "type": "string"
    },
    "specsys": {
     "type": "string",
     "nullable": true
    },
    "restfrq": {
     "type": "number",
     "nullable": true
    }
   }
  },
  "Flags": {
   "type": "object",
   "required": [
    "declared",
    "channels"
   ],
   "description": "Data-provider channel flags. Flagged channels keep their data; declared false means the file states no flags at all.",
   "properties": {
    "declared": {
     "type": "boolean"
    },
    "source": {
     "type": "string"
    },
    "channels": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "note": {
     "type": "string"
    }
   }
  },
  "View": {
   "type": "object",
   "description": "What the viewer needs to lay out a dataset: image size, which FITS axes are x, y and channel, and the sky and spectral readouts with their provenance.",
   "required": [
    "width",
    "height",
    "channels",
    "bunit",
    "bunit_status",
    "fits_axes",
    "sky",
    "spectral",
    "flags"
   ],
   "properties": {
    "width": {
     "type": "integer"
    },
    "height": {
     "type": "integer"
    },
    "channels": {
     "type": "integer"
    },
    "bunit": {
     "type": "string",
     "nullable": true
    },
    "bunit_status": {
     "type": "string",
     "enum": [
      "declared",
      "user",
      "unresolved"
     ],
     "description": "declared: the file's BUNIT; user: a unit the person declared for a file with none (never the file's); unresolved: neither"
    },
    "fits_axes": {
     "type": "object",
     "required": [
      "x",
      "y",
      "channel"
     ],
     "properties": {
      "x": {
       "type": "integer"
      },
      "y": {
       "type": "integer"
      },
      "channel": {
       "type": "integer",
       "nullable": true
      }
     }
    },
    "sky": {
     "oneOf": [
      {
       "$ref": "#/components/schemas/SkyPixel"
      },
      {
       "$ref": "#/components/schemas/SkyCelestial"
      }
     ],
     "discriminator": {
      "propertyName": "kind",
      "mapping": {
       "pixel": "#/components/schemas/SkyPixel",
       "celestial": "#/components/schemas/SkyCelestial"
      }
     }
    },
    "spectral": {
     "allOf": [
      {
       "$ref": "#/components/schemas/SpectralFacts"
      }
     ],
     "nullable": true
    },
    "flags": {
     "$ref": "#/components/schemas/Flags"
    }
   }
  },
  "PlaneStats": {
   "type": "object",
   "required": [
    "finite_count",
    "nonfinite_count",
    "min",
    "max",
    "p01",
    "p99",
    "overflow_count"
   ],
   "properties": {
    "finite_count": {
     "type": "integer"
    },
    "nonfinite_count": {
     "type": "integer"
    },
    "min": {
     "type": "number",
     "nullable": true
    },
    "max": {
     "type": "number",
     "nullable": true
    },
    "p01": {
     "type": "number",
     "nullable": true
    },
    "p99": {
     "type": "number",
     "nullable": true
    },
    "overflow_count": {
     "type": "integer"
    }
   }
  },
  "PlaneHeader": {
   "type": "object",
   "description": "The JSON header of a plane frame. NaN in the payload means no value, never zero. Extra keys may be present and are not part of the contract.",
   "required": [
    "width",
    "height",
    "channel",
    "channels",
    "nan_meaning",
    "stats",
    "spectral_value",
    "spectral_unit",
    "flagged",
    "source_bitpix",
    "scaled"
   ],
   "properties": {
    "width": {
     "type": "integer"
    },
    "height": {
     "type": "integer"
    },
    "channel": {
     "type": "integer"
    },
    "channels": {
     "type": "integer"
    },
    "nan_meaning": {
     "type": "string"
    },
    "stats": {
     "$ref": "#/components/schemas/PlaneStats"
    },
    "spectral_value": {
     "type": "number",
     "nullable": true
    },
    "spectral_unit": {
     "type": "string",
     "nullable": true
    },
    "flagged": {
     "type": "boolean",
     "nullable": true,
     "description": "null means the file declares no flags at all, which is not the same as not flagged."
    },
    "source_bitpix": {
     "type": "integer",
     "nullable": true
    },
    "scaled": {
     "type": "boolean"
    },
    "preview": {
     "type": "object",
     "nullable": true,
     "description": "Present on a reduced display preview: not for measurement; the full-resolution plane follows.",
     "required": [
      "step",
      "source_width",
      "source_height",
      "method"
     ],
     "properties": {
      "step": {
       "type": "integer"
      },
      "source_width": {
       "type": "integer"
      },
      "source_height": {
       "type": "integer"
      },
      "method": {
       "type": "string"
      }
     }
    }
   }
  },
  "UnitDeclaration": {
   "type": "object",
   "description": "The physical unit a person declared for a file whose header has no BUNIT. An overlay: the file and its header facts are never changed, and wherever the unit is shown it is labelled as declared by the person.",
   "required": [
    "unit",
    "declaredBy",
    "declaredAt",
    "stale"
   ],
   "properties": {
    "unit": {
     "type": "string",
     "description": "As typed: 1 to 40 printable characters. It is shown and compared as text and not converted."
    },
    "declaredBy": {
     "type": "string",
     "description": "\"user\""
    },
    "declaredAt": {
     "type": "string",
     "format": "date-time"
    },
    "stale": {
     "type": "boolean",
     "description": "The file's size or modification time differs from when the unit was declared: it may no longer describe these bytes."
    }
   }
  }
 },
 "operations": {
  "GET /api/datasets": {
   "summary": "List registered datasets",
   "responses": {
    "200": {
     "description": "ok",
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DatasetList"
       }
      }
     }
    },
    "default": {
     "description": "Error",
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Error"
       }
      }
     }
    }
   }
  },
  "GET /api/datasets/{id}": {
   "summary": "One registered dataset",
   "parameters": [
    {
     "name": "id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "integer",
      "format": "int64"
     }
    }
   ],
   "responses": {
    "200": {
     "description": "ok",
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Dataset"
       }
      }
     }
    },
    "default": {
     "description": "Error",
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Error"
       }
      }
     }
    }
   }
  },
  "GET /api/datasets/{id}/view": {
   "summary": "Axis roles, sky and spectral readouts for the viewer",
   "parameters": [
    {
     "name": "id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "integer",
      "format": "int64"
     }
    }
   ],
   "responses": {
    "200": {
     "description": "ok",
     "headers": {
      "Cache-Control": {
       "schema": {
        "type": "string",
        "enum": [
         "no-store"
        ]
       }
      }
     },
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/View"
       }
      }
     }
    },
    "default": {
     "description": "Error",
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Error"
       }
      }
     }
    }
   }
  },
  "GET /api/datasets/{id}/plane": {
   "summary": "One plane as a binary frame",
   "description": "Frame layout: uint32 little-endian header length n, then n bytes of JSON (a PlaneHeader, padded with spaces so the payload is 8-byte aligned), then width*height little-endian float32 pixels, row-major, row 0 = FITS y=1. Non-finite means no value. Only the transport and the JSON header are described here, not the binary payload.",
   "parameters": [
    {
     "name": "id",
     "in": "path",
     "required": true,
     "schema": {
      "type": "integer",
      "format": "int64"
     }
    },
    {
     "name": "channel",
     "in": "query",
     "required": true,
     "schema": {
      "type": "integer",
      "minimum": 0
     }
    },
    {
     "name": "step",
     "in": "query",
     "required": false,
     "description": "Reduction factor for a display preview; refused for an orientation map",
     "schema": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
     }
    }
   ],
   "responses": {
    "200": {
     "description": "ok",
     "headers": {
      "Cache-Control": {
       "schema": {
        "type": "string",
        "enum": [
         "no-store"
        ]
       }
      },
      "X-Content-Type-Options": {
       "schema": {
        "type": "string",
        "enum": [
         "nosniff"
        ]
       }
      }
     },
     "content": {
      "application/vnd.vesqira.plane": {
       "schema": {
        "type": "string",
        "format": "binary"
       },
       "x-frame-header": {
        "$ref": "#/components/schemas/PlaneHeader"
       }
      }
     }
    },
    "default": {
     "description": "Error",
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Error"
       }
      }
     }
    }
   }
  }
 }
}
